# Copy to .env and fill in. .env is gitignored; never commit the real one.

# --- AWS -------------------------------------------------------------------
# Set by `setx` during setup, repeated here so a fresh shell is self-describing.
AWS_PROFILE=second
AWS_REGION=us-west-2

# --- Second ----------------------------------------------------------------
SECOND_TABLE=second_graph
# Bucket names are global. Add a suffix if this one is taken.
SECOND_BUCKET=second-voice-demo

# --- The model -------------------------------------------------------------
# Pick ONE provider and set its key. build_model() refuses to start if the key
# for the chosen provider is missing, rather than failing on the first call.
#
#   gemini     free, no card, works in Nigeria. 5 requests/minute PER MODEL,
#              which is why each node runs on a different model.
#   cerebras   free tier, OpenAI-compatible. Sign up at cloud.cerebras.ai.
#   anthropic  paid. Bedrock refuses Anthropic models on this account
#              (country restriction), so the direct API is the route.
#
# groq is present in OPENAI_COMPATIBLE. The first Groq account was restricted at
# signup ("Restricted access -- violating our terms of service") before any API
# call; a second account's console and key work. Whether Groq honours forced tool
# choice is NOT verified yet: run scripts/probe_provider.py before relying on it.
SECOND_MODEL_PROVIDER=gemini

GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# ANTHROPIC_API_KEY=

# Pins every node to one Gemini model instead of the per-node spread. Leave
# UNSET on the free tier: setting it collapses twelve per-model quotas into one
# and also switches off model failover (alternates_for returns nothing when a
# model is pinned on purpose). Set it on a paid key.
# SECOND_GEMINI_MODEL=gemini-3.6-flash

# Pins what the whole system thinks today is. The seeded demo world is built
# relative to one date and goes stale when the date rolls over. Set it to the
# demo's date on the day.
# SECOND_DEMO_TODAY=2026-09-10

# --- Web search ------------------------------------------------------------
# One of these. Only the Resource Finder uses it, which is first on the cut list.
TAVILY_API_KEY=
# BRAVE_API_KEY=

# --- Google ----------------------------------------------------------------
# Paths to the two OAuth client files. Both gitignored.
#   runtime: calendar, gmail.readonly, gmail.compose   -- shipped
#   seeder:  gmail.insert, calendar.events             -- never shipped
GOOGLE_CLIENT_SECRET=client_secret.json
GOOGLE_SEED_CLIENT_SECRET=client_secret_seed.json
GOOGLE_TOKEN=token.json
GOOGLE_SEED_TOKEN=token_seed.json

# In a deployed runtime there is no browser, so the refresh token comes from
# Secrets Manager instead of a file. Set this and leave GOOGLE_TOKEN unset.
# SECOND_GOOGLE_SECRET_ID=second/google-refresh-token
