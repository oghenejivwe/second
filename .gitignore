# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv
.venv-*

# Node
node_modules/
web/dist/

# Credentials — never commit these
.env
.env.*
!.env.example
*.pem
client_secret*.json
credentials.json
# token*.json, not token.json: the seeder writes token_seed.json (see
# GOOGLE_SEED_TOKEN in .env.example) and the narrower pattern did not match it,
# so a live refresh token with gmail.insert and calendar.events would have been
# committed on the first `git add -A` after authorising the seeder. Caught while
# checking whether this repo was safe to make public.
token*.json
token*.pickle
.aws/

# Local tooling and build leftovers, not part of the project
.claude/
package/
pr.json
pr.tgz

# Local scratch
*.local
.DS_Store
